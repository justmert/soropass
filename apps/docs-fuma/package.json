{
  "name": "@soropass/docs-fuma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-demo.mjs && node scripts/prepare-matrix.mjs && pnpm exec react-router build",
    "predev": "node scripts/prepare-matrix.mjs",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "types:check": "react-router typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint"
  },
  "dependencies": {
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@takumi-rs/image-response": "^2.5.10",
    "fumadocs-core": "16.14.1",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.1",
    "isbot": "^5.2.1",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/react-router": "^1.3.1",
    "oxlint": "^1.69.0",
    "react-router-devtools": "^6.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
