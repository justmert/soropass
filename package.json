{
  "name": "stellar-passkey-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "matrix:pull": "pnpm --filter @soropass/matrix matrix:pull",
    "matrix:ci": "pnpm --filter @soropass/matrix matrix:ci",
    "matrix:build": "pnpm --filter @soropass/matrix matrix:build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@reown/appkit",
      "bufferutil",
      "utf-8-validate",
      "secp256k1"
    ],
    "overrides": {
      "@soropass/core": "workspace:*"
    }
  }
}
